generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model List {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  versions  Version[]
}

model Version {
  id        Int      @id @default(autoincrement())
  listId    Int
  number    Int
  content   Json // snapshot: [{ id, name, description, order }]
  createdAt DateTime @default(now())

  list List @relation(fields: [listId], references: [id])

  @@unique([listId, number])
}
